## =====================================================================
##  RoadLine RP (ex-GTA SOON) — server.cfg (V1)
##  Copier en server.cfg (ignoré par git). Secrets : cfg/secrets.cfg (ignoré aussi).
##  Ordre : réseau → identité → sécurité → secrets → convars → ressources → permissions → profil
##  Vérif avant chaque déploiement : ./tests/run.sh (linter de config inclus)
## =====================================================================

## ---- Réseau ----
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
# OneSync : activé par la ligne de commande (+set onesync on dans DEMARRER.bat), plus modifiable ici.
# Build du jeu : aligner sur ce qu'exige la version de Qbox installée (docs.qbox.re) avant de changer.
set sv_enforceGameBuild 3570

## ---- Identité (liste des serveurs) ----
sv_hostname "^5RoadLine ^7RP ^7| ^6FR ^7| La ville se souvient ^7| Free Access · Zéro P2W · Ville vivante"
sets sv_projectName "RoadLine RP · La ville se souvient"
sets sv_projectDesc "GTA RP 100 % FR new generation : témoins et preuves, rencontres de la route, rumeurs, prison vivante. Free Access, zéro pay-to-win."
sets locale "fr-FR"
sets tags "roleplay, rp, fr, francais, french, freeaccess, serious rp, new generation, police, gangs, enquetes, qbox"
sets Discord "https://discord.gg/8y2sX7EvZN"
sets Site "https://roadlinerp.netlify.app"
setr gs_version "V12.3"        # version RoadLine affichée (F11, console, METTRE-A-JOUR) : savoir quelle version tourne
setr gs_public_version "V4 · bêta"   # version affichée aux joueurs (écran de chargement, site, statut Discord), gs_version reste la version interne (staff)
# load_server_icon logo.png   # PNG 96x96

## ---- Sécurité de base (sans effet de bord) ----
sv_scriptHookAllowed 0          # pas de ScriptHook (menus de triche)
set sv_pureLevel 1              # refuse les fichiers de jeu modifiés (hors audio/graphismes)

## ---- Secrets (licence, BDD, webhooks, staff) ----
exec cfg/secrets.cfg

## ---- Réglages des ressources ----
exec cfg/convars.cfg

## ---- Ressources (ordre important) ----
exec cfg/resources.cfg

## Mods importés (véhicules, vêtements, maps) : écrit par IMPORTER-MODS.bat, jamais écrasé par METTRE-A-JOUR.
## Absent tant que tu n'as rien importé (message « could not execute » sans conséquence).
exec cfg/addons.cfg

## ---- Permissions ACE ----
exec cfg/permissions.cfg

## ---- Profil : dev (serveur caché, durcissement à valider) ou prod ----
exec cfg/dev.cfg
# exec cfg/prod.cfg
