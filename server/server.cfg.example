## =====================================================================
##  GTA SOON — server.cfg (V1)
##  Copier en server.cfg (ignoré par git). Secrets : cfg/secrets.cfg (ignoré aussi).
##  Ordre : réseau → identité → sécurité → secrets → convars → ressources → permissions → profil
##  Vérif avant chaque déploiement : ./tests/run.sh (linter de config inclus)
## =====================================================================

## ---- Réseau ----
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
# OneSync : activé par la ligne de commande (+set onesync on dans DEMARRER.bat), plus modifiable ici.
# Build du jeu : aligner sur ce qu'exige la version de Qbox installée (docs.qbox.re) avant de changer.
set sv_enforceGameBuild 3258

## ---- Identité (liste des serveurs) ----
sv_hostname "^5GTA SOON ^7| ^6FR ^7| Free Access | Zéro P2W"
sets sv_projectName "GTA SOON"
sets sv_projectDesc "RP francophone premium : néons, sunset et bonne humeur"
sets locale "fr-FR"
sets tags "roleplay, rp, fr, francais, freeaccess, qbox"
# sets Discord "https://discord.gg/XXXX"
# load_server_icon logo.png   # PNG 96x96

## ---- Sécurité de base (sans effet de bord) ----
sv_scriptHookAllowed 0          # pas de ScriptHook (menus de triche)
set sv_pureLevel 1              # refuse les fichiers de jeu modifiés (hors audio/graphismes)

## ---- Secrets (licence, BDD, webhooks, staff) ----
exec cfg/secrets.cfg

## ---- Réglages des ressources ----
exec cfg/convars.cfg

## ---- Ressources (ordre important) ----
exec cfg/resources.cfg

## ---- Permissions ACE ----
exec cfg/permissions.cfg

## ---- Profil : dev (serveur caché, durcissement à valider) ou prod ----
exec cfg/dev.cfg
# exec cfg/prod.cfg
