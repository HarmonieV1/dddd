## Copier en cfg/secrets.cfg (ignoré par git). Toujours `set` (jamais setr/sets : ça enverrait la valeur aux clients).
sv_licenseKey "CHANGE_ME"                       # keymaster.fivem.net
set steam_webApiKey "none"
set mysql_connection_string "mysql://gtasoon:CHANGE_ME@127.0.0.1/gtasoon?charset=utf8mb4"

## Webhooks Discord (vides = logs en console seulement)
set gs_staff_webhook ""                         # sécurité, rate-limit, commandes staff
set gs_webhook_jobs ""                          # embauches, caisses, missions suspectes
set gs_webhook_annonces ""                      # annonces publiques (météo...)
set gs_webhook_boutique ""                      # achats, réclamations, remboursements
set gs_webhook_sanctions ""                     # salon PUBLIC : sanctions (transparence, staff anonyme)
set gs_webhook_social ""                        # salon PUBLIC : miroir des posts de Vibe
set gs_webhook_anticheat ""                     # V9 : alertes anti-triche (sinon gs_staff_webhook)
set gs_webhook_status ""                        # V9 : salon #statut (un message mis à jour chaque minute)
set gs_connect ""                               # V9 : adresse pour rejoindre (ex : cfx.re/join/abc123)
set gs_discord_bot_token ""                     # V9 (optionnel) : jeton du bot, rôles de métier. NE JAMAIS PARTAGER
set gs_discord_guild ""                         # V9 (optionnel) : identifiant du serveur Discord
## CONFIGURER-DISCORD.bat remplit ces lignes pour toi.

## Photos Vibe / bodycam (optionnel, ressource screenshot-basic requise). Vide = appareil photo masqué.
## Le SERVEUR envoie l'image à l'hébergeur : la clé ne part jamais chez les joueurs (d'où `set`, jamais `setr`).
set gs_photo_upload_url ""                      # ex : adresse d'envoi de ton hébergeur d'images
set gs_photo_auth ""                            # en-tête Authorization (clé d'API de l'hébergeur), si demandé
set gs_photo_field "file"                       # nom du champ fichier attendu par l'hébergeur
set gs_photo_url_field "url"                    # champ de la réponse JSON qui contient l'adresse de l'image
set gs_photo_allowed_host ""                    # début des adresses d'images acceptées (ex : https://r2.fivemanage.com/)

## Liste blanche (candidature Discord) : "true" pour l'activer. Lien affiché aux non-inscrits.
set gs_whitelist "false"
set gs_discord_invite "discord.gg/8y2sX7EvZN"

## Tebex (boutique) : clé secrète du panel Tebex (Integrations → Game servers)
set sv_tebexSecret ""

## Staff : identifiants license: (visibles dans txAdmin). Jamais dans le repo.
# add_principal identifier.license:XXXXXXXX group.admin   # Alpha
# add_principal identifier.license:XXXXXXXX group.mod
